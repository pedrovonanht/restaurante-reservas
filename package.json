{
  "name": "restaurante-saas",
  "version": "1.0.0",
  "description": "saas para restaurantes gerenciarem reservas e vouchers",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run services:up && npm run service:wait:database && npm run migrations:up && next dev",
    "service:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m 'infra/migrations' --env-path .env.development create",
    "migrations:up": "node-pg-migrate -m 'infra/migrations' --env-path .env.development up",
    "services:up": "docker compose --file 'infra/compose.yaml' up -d",
    "services:down": "docker compose --file 'infra/compose.yaml' down",
    "services:stop": "docker compose --file 'infra/compose.yaml' stop",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "npx eslint .",
    "test": "npm run services:up && npm run service:wait:database && concurrently -n next,jest --hide next -k -s command-jest 'next dev' 'jest --runInBand'",
    "test:watch": "jest --watch",
    "commit": "cz",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.4.2",
    "dotenv-expand": "^13.0.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-connect": "1.0.0",
    "node-pg-migrate": "8.0.4",
    "pg": "8.21.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tailwindcss/postcss": "4.3.0",
    "commitizen": "4.3.1",
    "concurrently": "9.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "husky": "^9.1.7",
    "jest": "30.4.2",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.0",
    "uuid": "14.0.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
